# Moiz Web Solutions inquiry API — copy to `server/.env` and fill in.
# `server/.env` is git-ignored. Never commit real credentials.
#
# Local development:
#   1. Fill SMTP_* below (any provider that can send as your mailbox).
#   2. From `client/`, run `npm run dev:api` in one terminal and `npm run dev` in another.
#   Vite proxies `/api` to this process (PORT, default 8787).

NODE_ENV=development
PORT=8787

# Number of reverse proxies in front of the API (Render/Railway/Nginx = 1).
# Leave at 0 when the API is reached directly, otherwise IP rate limiting
# can be spoofed through a forged X-Forwarded-For header.
TRUST_PROXY=0

# Browser origins allowed to POST the form. Comma separated, no trailing slash.
# Include every local origin you actually use (Vite may not be 5173).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5199,http://localhost:5199

# ── SMTP credentials (server-side only, never VITE_*) ────────────────────
# Fill these in `server/.env`. The API will not send until all required
# values are present AND the transport authenticates.
#
# Google Workspace / Gmail (App Password; 2-Step Verification required):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=moizwebsolutions@gmail.com
#   SMTP_PASS=<16-character App Password — not the Google account password>
#
# Other providers: use their published SMTP host/port. Port 465 = implicit TLS
# (SMTP_SECURE=true). Port 587 = STARTTLS (SMTP_SECURE=false or blank).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Leave blank to auto-detect: implicit TLS on 465, STARTTLS elsewhere.
SMTP_SECURE=false
SMTP_USER=moizwebsolutions@gmail.com
SMTP_PASS=

# ── Addresses ────────────────────────────────────────────────────────────
# Sending identity. Must be a mailbox the SMTP account is allowed to send as.
# Defaults to SMTP_USER when blank.
MAIL_FROM_ADDRESS=moizwebsolutions@gmail.com
MAIL_FROM_NAME=Moiz Web Solutions Website

# Where project briefs are delivered. The browser can never change this.
BUSINESS_EMAIL=moizwebsolutions@gmail.com
BUSINESS_NAME=Moiz Web Solutions

# Public site URL, used in the email footer. Optional.
SITE_URL=

# Timezone for the "Submitted:" timestamp and the inquiry id date segment.
MAIL_TIMEZONE=Asia/Karachi

# Send the visitor a short receipt after the brief reaches the inbox.
SEND_CLIENT_CONFIRMATION=true

# ── Abuse protection ─────────────────────────────────────────────────────
INQUIRY_RATE_LIMIT_WINDOW_MS=600000
INQUIRY_RATE_LIMIT_MAX=5
INQUIRY_RATE_LIMIT_GLOBAL_MAX=120

# ── Portfolio database & admin ───────────────────────────────────────────
DB_PATH=

# Admin login (seeded on first run if no admin exists)
ADMIN_EMAIL=admin@moizwebsolutions.com
ADMIN_PASSWORD=changeme123

# JWT for admin sessions — change in production
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Project image uploads (served from /uploads/projects)
UPLOADS_DIR=
UPLOADS_PUBLIC_PATH=/uploads/projects
UPLOAD_MAX_BYTES=5242880
