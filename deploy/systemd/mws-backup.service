[Unit]
Description=Moiz Web Solutions SQLite + media snapshot
After=mws-api.service

[Service]
Type=oneshot
User=mws
Group=mws
WorkingDirectory=/var/www/mws/server
Environment=NODE_ENV=production
EnvironmentFile=-/var/www/mws/server/.env
UMask=0077
Nice=10
ExecStart=/usr/bin/env NODE_ENV=production /usr/bin/node scripts/backup-db.mjs
